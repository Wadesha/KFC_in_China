# ============================================================
# KFC_in_China 环境变量示例
# 复制本文件为 .env 并填入你自己的 Key（.env 已被 .gitignore 忽略，不会提交）
# ============================================================

# 腾讯地图 WebService API Key（地理编码 / 行政区划边界）
# 可填多个，用逗号分隔，脚本会自动轮换以规避每日配额限制
TENCENT_MAP_API_KEYS=your_tencent_key_1,your_tencent_key_2

# 高德地图 WebService API Key（用于 collect_stores_amap.py 另一种采集方式）
AMAP_API_KEY=your_amap_key
